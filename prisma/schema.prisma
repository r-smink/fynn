// FYNN — whitelabel AI chatplatform
// Prisma 7 + better-sqlite3 driver adapter

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String
  role          String         @default("member") // admin | member
  createdAt     DateTime       @default(now())
  brandId       String?
  brand         Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  conversations Conversation[]
  usage         UsageEvent[]
  fusions       FusionTemplate[]
  tasks         Task[]
  imageStyles   ImageStyle[]
  images        ImageGeneration[]
  imageFolders  ImageFolder[]
}

model Brand {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  description   String            @default("")
  logoUrl       String            @default("")
  websiteUrl    String            @default("")
  toneOfVoice   String            @default("")
  theme         String            @default("{}") // JSON: {primary, secondary, gradient, headingFont, bodyFont}
  isDefault     Boolean           @default(false)
  createdAt     DateTime          @default(now())
  agents        Agent[]
  sources       KnowledgeSource[]
  templates     PromptTemplate[]
  conversations Conversation[]
  users         User[]
  fusions       FusionTemplate[]
  tasks         Task[]
  imageStyles   ImageStyle[]
  imageFolders  ImageFolder[]
  images        ImageGeneration[]
}

model Agent {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String         @default("")
  icon          String         @default("Bot")
  color         String         @default("")
  systemPrompt  String
  brandId       String?
  brand         Brand?         @relation(fields: [brandId], references: [id])
  defaultModel  String         @default("")
  temperature   Float          @default(0.7)
  enabledTools  String         @default("[]") // JSON array of tool names
  isDefault     Boolean        @default(false)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  sources       KnowledgeSource[]
  templates     PromptTemplate[]
  conversations Conversation[]
  tasks         Task[]
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId   String?
  agent     Agent?    @relation(fields: [agentId], references: [id])
  brandId   String?
  brand     Brand?    @relation(fields: [brandId], references: [id])
  model     String    @default("")
  title     String    @default("Nieuw gesprek")
  pinned    Boolean   @default(false)
  archived  Boolean   @default(false) // gearchiveerd = blijft altijd bewaard (zie lib/retention.ts)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId, pinned, updatedAt])
  @@index([archived, pinned, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant | system | tool
  parts          String // JSON-serialized UIMessage parts
  model          String       @default("")
  usage          String       @default("{}")
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model KnowledgeSource {
  id         String           @id @default(cuid())
  name       String
  type       String // file | upload | url | sitemap | git | folder
  config     String           @default("{}") // JSON: {url, repoUrl, branch, globs, localPath, credentialId}
  brandId    String?
  brand      Brand?           @relation(fields: [brandId], references: [id])
  status     String           @default("pending") // pending | syncing | ready | error
  statusMsg  String           @default("")
  lastSyncAt DateTime?
  chunkCount Int              @default(0)
  createdAt  DateTime         @default(now())
  chunks     KnowledgeChunk[]
  assets     KnowledgeAsset[]
  repoFiles  RepoFile[]
  agents     Agent[]

  @@index([brandId])
}

model KnowledgeAsset {
  id          String          @id @default(cuid())
  sourceId    String
  source      KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  filename    String
  storageKey  String
  contentType String
  size        Int
  caption     String          @default("")
  editPolicy  String          @default("free") // locked | minimal | free — hoeveel de AI dit beeld mag aanpassen
  createdAt   DateTime        @default(now())

  @@index([sourceId])
}

model KnowledgeChunk {
  id        String          @id @default(cuid())
  sourceId  String
  source    KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  path      String          @default("") // file path or url of the chunk
  text      String
  embedding Bytes // Float32Array little-endian
  meta      String          @default("{}")
  createdAt DateTime        @default(now())

  @@index([sourceId])
}

model RepoFile {
  id       String          @id @default(cuid())
  sourceId String
  source   KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  path     String
  content  String

  @@unique([sourceId, path])
}

model ModelEntry {
  id              String   @id // openrouter model id, e.g. "openai/gpt-5"
  name            String
  provider        String   @default("")
  contextLength   Int      @default(0)
  promptPrice     Float    @default(0) // USD per 1M tokens
  completionPrice Float    @default(0) // USD per 1M tokens
  modality        String   @default("") // e.g. "text+image->text"
  description     String   @default("")
  syncedAt        DateTime @default(now())
}

model PromptTemplate {
  id        String   @id @default(cuid())
  title     String
  category  String   @default("") // linkedin | blog | newsletter | ad | landing | custom
  prompt    String
  brandId   String?
  brand     Brand?   @relation(fields: [brandId], references: [id])
  agents    Agent[]
  createdAt DateTime @default(now())
}

model FusionTemplate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId     String?
  brand       Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  name        String
  description String   @default("")
  leadModel   String
  leadEffort  String   @default("") // minimal | low | medium | high | xhigh — leeg = model-default
  sidekick1   String   @default("")
  sidekick2   String   @default("")
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([brandId])
}

model Task {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId      String?
  brand        Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  name         String
  agentId      String?
  agent        Agent?    @relation(fields: [agentId], references: [id])
  model        String    @default("") // openrouter id of "fusion:<id>" — leeg = agent-default
  prompt       String
  schedule     String    @default("") // cron-expressie; leeg = alleen handmatig
  action       String    @default("chat_run") // chat_run | wordpress_post
  actionConfig String    @default("{}") // JSON, o.a. {status: "draft"|"publish", categories, tags}
  enabled      Boolean   @default(true)
  lastRunAt    DateTime?
  createdAt    DateTime  @default(now())
  runs         TaskRun[]

  @@index([userId])
  @@index([brandId])
  @@index([enabled, lastRunAt])
}

model TaskRun {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status    String   @default("running") // running | done | error
  output    String   @default("")
  resultUrl String   @default("") // bijv. link naar WP-draft
  error     String   @default("")
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

model UsageEvent {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id])
  conversationId   String   @default("")
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  cost             Float    @default(0) // USD
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

model Setting {
  key   String @id
  value String
}

/** Stijl-preset voor de beeldstudio (naast de ingebouwde presets uit lib/image-styles.ts). */
model ImageStyle {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId     String?
  brand       Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  name        String
  emoji       String   @default("🎨")
  prompt      String // stijlinstructie die aan de prompt wordt toegevoegd
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([brandId])
}

model ImageGeneration {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId     String?
  brand       Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  folderId    String?
  folder      ImageFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  prompt      String
  style       String   @default("") // naam van de gebruikte preset
  model       String
  aspectRatio String   @default("")
  url         String
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([folderId, createdAt])
}

/** Map in de beeldbank; genest via parentId, gedeeld binnen een brand. */
model ImageFolder {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId   String?
  brand     Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  parentId  String?
  parent    ImageFolder?      @relation("ImageFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  ImageFolder[]     @relation("ImageFolderTree")
  name      String
  createdAt DateTime          @default(now())
  images    ImageGeneration[]

  @@index([userId])
  @@index([brandId])
  @@index([parentId])
}
