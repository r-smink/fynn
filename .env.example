# --- Database (SQLite, pad relatief t.o.v. de projectroot) ---
DATABASE_URL="file:./data/fynn.db"
# Map voor db, repo-clones, uploads en gegenereerde images
FYNN_DATA_DIR="./data"

# --- Auth (next-auth v4) ---
# Genereer met: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- OpenRouter (vereist voor chat, embeddings en images) ---
OPENROUTER_API_KEY=""
EMBEDDING_MODEL="openai/text-embedding-3-small"
IMAGE_MODEL="google/gemini-2.5-flash-image-preview"

# --- Fyndable admin-API (optioneel, voor live platform-data) ---
FYNDABLE_PORTAL_URL="https://portal.fyndable.ai"
FYNDABLE_WP_USER=""
FYNDABLE_WP_APP_PASSWORD=""

# --- Seed (optioneel; anders wordt een random wachtwoord geprint) ---
SEED_ADMIN_EMAIL="admin@fynn.local"
SEED_ADMIN_PASSWORD=""
