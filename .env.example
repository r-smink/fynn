# --- Database (PostgreSQL) ---
# Lokaal: docker compose up -d db  ·  Vercel: koppel Neon via de Marketplace (zet DATABASE_URL zelf)
DATABASE_URL="postgresql://fynn:fynn@localhost:5432/fynn"

# --- Bestandsopslag (uploads + gegenereerde images) ---
# Gezet → Vercel Blob (private store). Leeg → lokaal in FYNN_DATA_DIR.
BLOB_READ_WRITE_TOKEN=""
FYNN_DATA_DIR="./data"

# --- Auth (next-auth v4) ---
# Genereer met: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- OpenRouter (vereist voor chat, embeddings en images) ---
OPENROUTER_API_KEY=""
EMBEDDING_MODEL="openai/text-embedding-3-small"
IMAGE_MODEL="google/gemini-2.5-flash-image"
VISION_MODEL="google/gemini-2.5-flash-lite"

# --- Fyndable admin-API (optioneel, voor live platform-data) ---
FYNDABLE_PORTAL_URL="https://portal.fyndable.ai"
FYNDABLE_WP_USER=""
FYNDABLE_WP_APP_PASSWORD=""

# --- WordPress publicatie (geautomatiseerde taken → blogposts) ---
# Valt terug op FYNDABLE_WP_* als WP_USER/WP_APP_PASSWORD leeg zijn.
WP_SITE_URL="https://fyndable.ai"
WP_USER=""
WP_APP_PASSWORD=""

# --- Scheduler (/api/cron/run-due; GitHub Actions roept dit elke 15 min aan) ---
CRON_SECRET=""

# --- Seed (optioneel; anders wordt een random wachtwoord geprint) ---
SEED_ADMIN_EMAIL="admin@fynn.local"
SEED_ADMIN_PASSWORD=""
